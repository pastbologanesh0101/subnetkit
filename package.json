{
  "name": "subnetkit",
  "version": "0.1.0",
  "description": "A fast, zero-dependency IPv4 subnet calculator for the command line.",
  "keywords": [
    "subnet",
    "cidr",
    "ipv4",
    "netmask",
    "network",
    "cli",
    "ip-calculator",
    "vlsm"
  ],
  "license": "MIT",
  "author": "pastbologanesh0101",
  "type": "module",
  "bin": {
    "subnetkit": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
